# Clubhouse API Credentials
CLUBHOUSE_API_KEY=your_api_key_here
CLUBHOUSE_API_SECRET=your_api_secret_here
CLUBHOUSE_USER_ID=your_user_id_here

# Room & Channel Settings
TARGET_ROOM_ID=your_room_id_here
TARGET_CHANNEL_ID=your_channel_id_here

# Automation Settings
CHECK_INTERVAL=30
MESSAGE_DELAY=2
AUTO_START=true

# Debug & Testing
DEBUG=false
DRY_RUN=false

# CSV Settings
USE_CSV_FILE=true
CSV_FILE_PATH=users.csv

# Advanced
TIMEOUT=10
MAX_RETRIES=3
RATE_LIMIT_DELAY=1